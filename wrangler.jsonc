{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theminiwear",
  "account_id": "eca56c90cea16c5e271719f6b26769d5",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "theminiwear-uploads",
      // Use the real (production) bucket during local dev too, so images
      // uploaded locally are readable on the live site (they share one DB).
      "remote": true
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://pub-1756d0c5dc364b8f9e2d9109e1b0fc67.r2.dev",
    "NEXTAUTH_URL": "https://theminiwear.com",
    "NEXT_PUBLIC_SITE_URL": "https://theminiwear.com",
    "ADMIN_NOTIFICATION_EMAIL": "faiza.farook85@gmail.com",
    "NEXT_PUBLIC_STORE_CURRENCY": "CAD",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_live_51To26OC3vS2DJWKyEOG4GwkIcS555q0zslpmFUgsKgZjSc5zc2QcM4StdFuBAd9UT3MLu4FdBD3gKYaYC75X4LmN000yD9sd8O"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "theminiwear"
    }
  ],
  // Paid Workers plan allows up to 300_000 ms; 30s is plenty for Next.js SSR/admin.
  "limits": {
    "cpu_ms": 30000
  },
}