# Database (Neon PostgreSQL)
# Pooled URL for the app / Cloudflare Workers
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct URL for prisma db push / migrations (no -pooler in hostname)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (canonical domain for SEO, sitemap, and Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Storefront currency (ISO 4217)
NEXT_PUBLIC_STORE_CURRENCY="CAD"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend (optional for dev - emails log to console)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@yourdomain.com"

# Admin alerts for new orders, inquiries, returns, and reviews
ADMIN_NOTIFICATION_EMAIL="faiza.farook85@gmail.com"

# Secret for scheduled jobs (e.g. daily low-stock digest: GET /api/cron/low-stock)
CRON_SECRET="generate-a-random-secret-here"

# Alert when variant stock falls to this level or below (default: 5)
LOW_STOCK_THRESHOLD="5"

# Firebase Storage
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
